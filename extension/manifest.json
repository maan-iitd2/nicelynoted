{
  "manifest_version": 3,
  "name": "NicelyNoted",
  "version": "0.1.0",
  "description": "Free meeting notes for Google Meet: records the call locally, then sends the transcript to ChatGPT for notes and tasks.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "NicelyNoted",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt.js"
      ]
    }
  ]
}